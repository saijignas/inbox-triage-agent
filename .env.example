# Copy to .env (never commit .env)

# dev | prod. In prod, JWT_SECRET must be set explicitly.
APP_ENV=dev
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# SQLite for local dev; Postgres for docker-compose / production:
# DATABASE_URL=postgresql+psycopg://triage:triage@db:5432/triage
DATABASE_URL=sqlite:///./triage.db

# fake (deterministic, no network, default) | gemini (needs GEMINI_API_KEY)
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Agent limits
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=30

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Frontend (build-time)
NEXT_PUBLIC_API_URL=http://localhost:8000
